# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server only — never exposed to the browser

# Passphrase required to add tournaments from /new
ADMIN_KEY=

# Shared secret the scheduled updater sends as the x-update-secret header
UPDATE_SECRET=

# Tabroom account the updater logs in with (results pages require a login)
TABROOM_USERNAME=
TABROOM_PASSWORD=
